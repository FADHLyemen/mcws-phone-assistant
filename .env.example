# ── Webhook (Cloud Run) environment ─────────────────────────────
# Prayer-times source: AthanPlus masjid id (default is MCWS = RKxwV5dO)
ATHANPLUS_MASJID_ID=RKxwV5dO
# Optional: require this shared secret on webhook calls (also set on the Vapi tools)
VAPI_SECRET=
# Events source (optional). If set, the assistant reads structured events from a
# public Google Calendar iCal (.ics) feed (recurring events supported); if unset,
# it falls back to live-scraping the website's events page.
EVENTS_ICS_URL=          # Google Calendar "Public address in iCal format" (ends in .ics)
EVENTS_TZ=America/Detroit
EVENTS_WINDOW_DAYS=60    # how far ahead to look
EVENTS_MAX=8            # max events to return
# Optional message delivery for take_a_message (default = Cloud Run logs only):
MESSAGES_BUCKET=          # a GCS bucket name to store each message as JSON
NOTIFY_TO=               # comma-separated email recipients
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── deploy_vapi.py environment ──────────────────────────────────
VAPI_API_KEY=            # your Vapi PRIVATE api key (dashboard.vapi.ai -> API Keys)
WEBHOOK_URL=             # the deployed Cloud Run URL, e.g. https://xxx.run.app
AREA_CODE=734            # desired US area code for the free pilot number
# Optional overrides:
# VOICE_PROVIDER=11labs
# VOICE_ID=21m00Tcm4TlvDq8ikWAM
# MODEL_PROVIDER=openai
# MODEL=gpt-4o
# SKIP_NUMBER=1          # create/update the assistant only, no number
